PORT=3000
APP_URL=http://localhost:3000

TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=

WHISPER_MODEL=Xenova/whisper-base
WHISPER_LANGUAGE=spanish

# El email que "es dueño" de las notas que crea el bot de Telegram.
# Tiene que coincidir con el email de Google con el que ese mismo dueño
# inicia sesion en la web.
OWNER_EMAIL=

# Credenciales de Google OAuth (console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Emails de Google autorizados a iniciar sesion, separados por coma
ALLOWED_EMAILS=

# Clave para firmar las cookies de sesion (cualquier string largo y random)
SESSION_SECRET=
