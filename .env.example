PORT=3000
APP_URL=http://localhost:3000

TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=

WHISPER_MODEL=Xenova/whisper-base
WHISPER_LANGUAGE=spanish

# Si esta seteado, el server NUNCA carga Whisper localmente: manda el audio
# a este servicio (ver transcribe-service/) para que transcriba otra
# maquina (ej. una mini PC en casa por Tailscale). Dejar vacio para
# transcribir localmente como antes.
TRANSCRIBE_REMOTE_URL=
TRANSCRIBE_SECRET=

# El email que "es dueño" de las notas que crea el bot de Telegram para el
# usuario TELEGRAM_ALLOWED_USER_ID. Tiene que coincidir con el email de
# Google con el que ese mismo dueño inicia sesion en la web.
OWNER_EMAIL=

# Gente adicional que puede usar el bot, cada una con su propio corcho.
# Formato: id_de_telegram:email,id_de_telegram:email
# (el id de Telegram se consigue hablandole a @userinfobot)
TELEGRAM_OWNERS=

# Credenciales de Google OAuth (console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Emails de Google autorizados a iniciar sesion, separados por coma.
# Vacio = cualquier cuenta de Google puede entrar y se crea su propio
# corcho vacio (login abierto).
ALLOWED_EMAILS=

# Invitados de solo lectura: ven el corcho de otra persona sin poder
# editarlo, agregar notas ni borrar nada. Formato:
# invitado@mail.com:dueño@mail.com,otro_invitado@mail.com:dueño@mail.com
# (el email del invitado igual tiene que poder loguearse: si ALLOWED_EMAILS
# no esta vacio, agregalo ahi tambien)
READONLY_GUESTS=

# Clave para firmar las cookies de sesion (cualquier string largo y random)
SESSION_SECRET=

# Dia (0=domingo..6=sabado) y hora (0-23, hora del server) en que el bot
# manda el resumen semanal por Telegram. Default: domingo 20hs.
WEEKLY_SUMMARY_DAY=0
WEEKLY_SUMMARY_HOUR=20

# Cada cuantas horas insiste el bot con un recordatorio que ya sono pero
# la nota sigue sin marcarse como hecha. Default: cada 24hs.
REMINDER_NAG_HOURS=24
